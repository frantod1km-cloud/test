{
  "name": "bzapp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose -f docker-compose.yml up -d",
    "db:down": "docker compose -f docker-compose.yml down",
    "db:logs": "docker compose -f docker-compose.yml logs -f postgres",
    "db:migrate": "pnpm --filter @bzapp/db prisma migrate dev",
    "db:deploy": "pnpm --filter @bzapp/db prisma migrate deploy",
    "db:seed": "pnpm --filter @bzapp/db seed",
    "db:studio": "pnpm --filter @bzapp/db prisma studio",
    "db:reset": "pnpm --filter @bzapp/db prisma migrate reset",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
